# Mainspring local runtime
NODE_ENV=development

# Provider credentials are referenced by opaque credential refs.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Canonical RunLog and local gateway.
MAINSPRING_RUNLOG_ROOT=.mainspring/runlog
MAINSPRING_RUNLOG_DB=.mainspring/runlog/runlog.sqlite
MAINSPRING_RUNLOG_WORKSPACE_ROOT=.mainspring/runlog/workspaces
MAINSPRING_RUNLOG_APPROVAL_KEY_MODE=local-dev
MAINSPRING_RUNLOG_APPROVAL_KEY=
MAINSPRING_GATEWAY_HOST=127.0.0.1
MAINSPRING_GATEWAY_PORT=8787
MAINSPRING_GATEWAY_APP_DB=.mainspring/gateway-app.sqlite
MAINSPRING_GATEWAY_CRON_ENABLED=1

# Compatibility mailbox runtime roots.
MAINSPRING_RUNTIME_ROOT=.mainspring/runtime
MAINSPRING_SESSIONS_ROOT=.mainspring/sessions
MAINSPRING_WORKSPACE_ROOT=.mainspring/workspace
MAINSPRING_POLL_INTERVAL_MS=1000

# Provider defaults.
MAINSPRING_PROVIDER=openrouter
MAINSPRING_MODEL=openrouter/free
MAINSPRING_CREDENTIAL_REF=env:OPENROUTER_API_KEY
MAINSPRING_PROVIDER_REQUEST_TIMEOUT_MS=45000

# Optional outbound control channel.
MAINSPRING_CHANNEL_URL=
MAINSPRING_CHANNEL_TOKEN=
